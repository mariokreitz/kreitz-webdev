{
  "name": "kreitz-webdev",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "nx": "nx",
    "serve": "nx run-many -t serve -p api,frontend,portal",
    "serve:api": "nx serve api",
    "serve:frontend": "nx serve frontend",
    "serve:frontend:ssr": "nx run frontend:serve-ssr",
    "serve:portal": "nx serve portal",
    "build": "nx run-many -t build --all",
    "build:prod": "nx run-many -t build --all -c production",
    "build:api": "nx build api",
    "build:frontend": "nx build frontend",
    "build:portal": "nx build portal",
    "lint": "nx run-many -t lint --all",
    "lint:fix": "nx run-many -t lint --all --fix",
    "lint:api": "nx lint api",
    "lint:frontend": "nx lint frontend",
    "lint:portal": "nx lint portal",
    "test": "nx run-many -t test --all",
    "test:api": "nx test api",
    "test:frontend": "nx test frontend",
    "test:portal": "nx test portal",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:api": "prettier --write apps/api",
    "format:frontend": "prettier --write apps/frontend",
    "format:portal": "prettier --write apps/portal",
    "graph": "nx graph",
    "projects": "nx show projects",
    "typecheck": "nx run-many --target=tsc --all",
    "typecheck:api": "nx run api:tsc",
    "typecheck:frontend": "nx run frontend:tsc",
    "typecheck:portal": "nx run portal:tsc",
    "docker:db:up": "docker-compose up --build -d",
    "prisma:generate": "dotenv -e .env.local -- prisma generate --config apps/api/prisma.config.ts",
    "prisma:migrate": "dotenv -e .env.local -- prisma migrate dev --config apps/api/prisma.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config apps/api/prisma.config.ts",
    "prisma:studio": "dotenv -e .env.local -- prisma studio --config apps/api/prisma.config.ts",
    "prisma:reset": "dotenv -e .env.local -- prisma migrate reset --config apps/api/prisma.config.ts",
    "auth:generate": "cd apps/api && dotenv -e ../../.env.local -- better-auth generate --config src/core/auth/auth-cli.config.ts --output prisma/schema.prisma",
    "postinstall": "dotenv -e .env.local -- prisma generate --config apps/api/prisma.config.ts",
    "prepare": "husky",
    "i18n:check": "verbatra check"
  },
  "private": true,
  "overrides": {
    "@better-auth/redis-storage": {
      "ioredis": "^6.0.0"
    }
  },
  "dependencies": {
    "@angular/cdk": "^22.1.1",
