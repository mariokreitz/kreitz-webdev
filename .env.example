NODE_ENV=development
API_PORT=3000
FRONTEND_PORT=4000
PORTAL_PORT=4201
LOG_LEVEL=debug
# pretty (colorized, dev) | json (structured, prod) - defaults by NODE_ENV if unset
LOG_FORMAT=pretty

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kreitz_webdev
REDIS_URL=redis://localhost:6379

# min 32 chars, e.g. `openssl rand -hex 32`
COOKIE_SECRET=

# api key for dashboard
BETTER_AUTH_API_KEY=
# min 32 chars, e.g. `openssl rand -hex 32`
BETTER_AUTH_SECRET=
# the API's own base URL (not the frontend's)
BETTER_AUTH_URL=http://localhost:3000

# the portal app's base URL (where the auth UI lives), used for password-reset links and Better Auth's OAuth error redirect ({APP_BASE_URL}/auth/error)
APP_BASE_URL=http://localhost:4201

CORS_ORIGINS=http://localhost:4200,http://localhost:4201
CORS_CREDENTIALS=true

TRUST_PROXY=false
PROXY_HOPS=0
ENABLE_SWAGGER=true

# from a GitHub OAuth App: https://github.com/settings/developers
# better-auth derives the callback path from BETTER_AUTH_URL by convention
# ({BETTER_AUTH_URL}/api/auth/callback/github) - register that literal URL on the GitHub OAuth App.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# from https://resend.com/api-keys
# the sandbox address below works without a verified domain
RESEND_API_KEY=
RESEND_FROM=Kreitz WebDev <onboarding@resend.dev>

# from https://app.arcjet.com (or `npx @arcjet/cli sites get-key`)
ARCJET_KEY=
# comma-separated trusted proxy IPs/CIDRs in front of the app (e.g. Dokploy's load balancer); leave empty locally
# also used by Better Auth (advanced.ipAddress.trustedProxies) to detect the real client IP for rate limiting/session tracking
ARCJET_TRUSTED_PROXIES=
