NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kreitz_webdev
REDIS_URL=redis://localhost:6379

# min 32 chars, e.g. `openssl rand -hex 32`
COOKIE_SECRET=

# min 32 chars, e.g. `openssl rand -hex 32`
BETTER_AUTH_SECRET=
# the API's own base URL (not the frontend's)
BETTER_AUTH_URL=http://localhost:3000

APP_BASE_URL=http://localhost:4200

CORS_ORIGINS=http://localhost:4200
CORS_CREDENTIALS=true

TRUST_PROXY=false
ENABLE_SWAGGER=true

# from a GitHub OAuth App: https://github.com/settings/developers
# better-auth derives the callback path from BETTER_AUTH_URL by convention
# ({BETTER_AUTH_URL}/api/auth/callback/github) - register that literal URL on the GitHub OAuth App.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# from https://resend.com/api-keys
# the sandbox address below works without a verified domain
RESEND_API_KEY=
RESEND_FROM=Kreitz WebDev <onboarding@resend.dev>
